generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum StudentStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
  MAKEUP
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  VIETQR
  CARD
  OTHER
}

enum CashFlowType {
  INCOME
  EXPENSE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationChannel {
  ZALO
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PackageBillingType {
  TIME_BASED
  SESSION_BASED
  PT
  CUSTOM
}

enum PackageDurationUnit {
  DAY
  WEEK
  MONTH
}

enum StudentPackageStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum BankTransferEventStatus {
  RECEIVED
  MATCHED
  UNMATCHED
  NEEDS_REVIEW
  IGNORED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  fullName     String
  phone        String?
  email        String?    @unique
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles        UserRole[]
  teacher      Teacher?
  tasksCreated Task[]     @relation("TaskCreator")
  tasksOwned   Task[]     @relation("TaskOwner")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())

  students     Student[]
  classes      Class[]
  transactions CashTransaction[]
  sales        Sale[]
}

model Student {
  id                  String        @id @default(cuid())
  code                String        @unique
  fullName            String
  dateOfBirth         DateTime?
  gender              String?
  phone               String?
  email               String?
  address             String?
  joinedAt            DateTime      @default(now())
  status              StudentStatus @default(ACTIVE)
  beltLevel           String?
  note                String?
  consecutiveAbsences Int           @default(0)
  branchId            String
  branch              Branch        @relation(fields: [branchId], references: [id])

  guardians     StudentGuardian[]
  enrollments   Enrollment[]
  attendances   Attendance[]
  learningNotes LearningNote[]
  invoices      TuitionInvoice[]
  reservations  FeeReservation[]
  notifications NotificationLog[]
  packages      StudentPackage[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([branchId, status])
  @@index([fullName])
}

model Guardian {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  zaloUid   String?
  canLogin  Boolean  @default(false)
  createdAt DateTime @default(now())

  students StudentGuardian[]

  @@index([phone])
}

model StudentGuardian {
  studentId  String
  guardianId String
  relation   String?
  isPrimary  Boolean  @default(false)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  employeeCode  String   @unique
  payPerSession Decimal? @db.Decimal(12, 2)
  payPerHour    Decimal? @db.Decimal(12, 2)
  active        Boolean  @default(true)
  user          User     @relation(fields: [userId], references: [id])

  classes       Class[]
  sessions      ClassSession[]
  timesheets    TeacherTimesheet[]
  learningNotes LearningNote[]
}

model Class {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  description       String?
  branchId          String
  teacherId         String?
  capacity          Int?
  scheduleText      String?
  tuitionPerSession Decimal? @db.Decimal(12, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  branch        Branch         @relation(fields: [branchId], references: [id])
  teacher       Teacher?       @relation(fields: [teacherId], references: [id])
  enrollments   Enrollment[]
  sessions      ClassSession[]
  learningNotes LearningNote[]

  @@index([branchId, active])
}

model Enrollment {
  id                    String           @id @default(cuid())
  studentId             String
  classId               String
  startedAt             DateTime         @default(now())
  endedAt               DateTime?
  status                EnrollmentStatus @default(ACTIVE)
  customPricePerSession Decimal?         @db.Decimal(12, 2)

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId, startedAt])
  @@index([classId, status])
}

model ClassSession {
  id          String    @id @default(cuid())
  classId     String
  teacherId   String?
  startsAt    DateTime
  endsAt      DateTime?
  topic       String?
  note        String?
  isCancelled Boolean   @default(false)

  class       Class              @relation(fields: [classId], references: [id])
  teacher     Teacher?           @relation(fields: [teacherId], references: [id])
  attendances Attendance[]
  timesheets  TeacherTimesheet[]

  @@index([classId, startsAt])
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  checkedAt DateTime         @default(now())
  checkedBy String?
  note      String?

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId, checkedAt])
}

model LearningNote {
  id        String   @id @default(cuid())
  studentId String?
  classId   String?
  teacherId String?
  content   String
  rating    Int?
  createdAt DateTime @default(now())

  student Student? @relation(fields: [studentId], references: [id])
  class   Class?   @relation(fields: [classId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId, createdAt])
  @@index([classId, createdAt])
}

model TuitionInvoice {
  id               String          @id @default(cuid())
  invoiceNo        String          @unique
  studentId        String
  periodStart      DateTime
  periodEnd        DateTime
  dueDate          DateTime
  status           InvoiceStatus   @default(UNPAID)
  attendedSessions Int             @default(0)
  subtotal         Decimal         @db.Decimal(12, 2)
  discount         Decimal         @default(0) @db.Decimal(12, 2)
  reservedCredit   Decimal         @default(0) @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  paidAmount       Decimal         @default(0) @db.Decimal(12, 2)
  customContent    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  studentPackageId String?         @unique
  studentPackage   StudentPackage? @relation(fields: [studentPackageId], references: [id])

  student       Student              @relation(fields: [studentId], references: [id])
  items         TuitionInvoiceItem[]
  payments      Payment[]
  notifications NotificationLog[]

  @@index([studentId, status, dueDate])
  @@index([studentPackageId])
}

model TuitionInvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  title         String
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?

  invoice TuitionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  paymentNo     String        @unique
  invoiceId     String?
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  bankReference String?
  qrContent     String?
  note          String?

  invoice TuitionInvoice? @relation(fields: [invoiceId], references: [id])
  receipt Receipt?
}

model Receipt {
  id        String   @id @default(cuid())
  receiptNo String   @unique
  paymentId String   @unique
  issuedAt  DateTime @default(now())
  pdfUrl    String?
  payment   Payment  @relation(fields: [paymentId], references: [id])
}

model FeeReservation {
  id        String   @id @default(cuid())
  studentId String
  fromDate  DateTime
  toDate    DateTime
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  remaining Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, remaining])
}

model CashTransaction {
  id            String       @id @default(cuid())
  branchId      String
  type          CashFlowType
  category      String
  amount        Decimal      @db.Decimal(12, 2)
  occurredAt    DateTime     @default(now())
  description   String?
  referenceType String?
  referenceId   String?

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, occurredAt])
}

model Product {
  id       String   @id @default(cuid())
  sku      String   @unique
  name     String
  unit     String?
  price    Decimal  @db.Decimal(12, 2)
  cost     Decimal? @db.Decimal(12, 2)
  stockQty Int      @default(0)
  active   Boolean  @default(true)

  items SaleItem[]
}

model Sale {
  id               String        @id @default(cuid())
  saleNo           String        @unique
  branchId         String
  studentId        String?
  status           SaleStatus    @default(COMPLETED)
  total            Decimal       @db.Decimal(12, 2)
  soldAt           DateTime      @default(now())
  paymentMethod    PaymentMethod @default(CASH)
  paymentReference String?
  paymentNote      String?

  branch Branch     @relation(fields: [branchId], references: [id])
  items  SaleItem[]

  @@index([branchId, soldAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model TeacherTimesheet {
  id           String   @id @default(cuid())
  teacherId    String
  sessionId    String?
  workDate     DateTime
  minutes      Int      @default(0)
  sessionCount Int      @default(0)
  amount       Decimal? @db.Decimal(12, 2)
  note         String?

  teacher Teacher       @relation(fields: [teacherId], references: [id])
  session ClassSession? @relation(fields: [sessionId], references: [id])

  @@index([teacherId, workDate])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  creatorId   String
  ownerId     String?
  dueAt       DateTime?
  status      TaskStatus @default(TODO)
  priority    Int        @default(2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  creator User  @relation("TaskCreator", fields: [creatorId], references: [id])
  owner   User? @relation("TaskOwner", fields: [ownerId], references: [id])

  @@index([ownerId, status, dueAt])
}

model NotificationLog {
  id          String              @id @default(cuid())
  studentId   String?
  invoiceId   String?
  channel     NotificationChannel
  templateKey String?
  recipient   String
  content     String
  status      NotificationStatus  @default(PENDING)
  providerId  String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  student Student?        @relation(fields: [studentId], references: [id])
  invoice TuitionInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([status, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model LearningPackage {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  billingType      PackageBillingType   @default(TIME_BASED)
  durationValue    Int?
  durationUnit     PackageDurationUnit?
  sessionsPerWeek  Int?
  includedSessions Int?
  price            Decimal              @db.Decimal(12, 2)
  description      String?
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  subscriptions StudentPackage[]

  @@index([active, name])
}

model StudentPackage {
  id             String               @id @default(cuid())
  studentId      String
  packageId      String
  startDate      DateTime
  endDate        DateTime?
  paymentDueDate DateTime?
  status         StudentPackageStatus @default(ACTIVE)

  packageCodeSnapshot      String
  packageNameSnapshot      String
  billingTypeSnapshot      PackageBillingType
  durationValueSnapshot    Int?
  durationUnitSnapshot     PackageDurationUnit?
  sessionsPerWeekSnapshot  Int?
  includedSessionsSnapshot Int?
  priceSnapshot            Decimal              @db.Decimal(12, 2)

  note            String?
  pauseStartedAt  DateTime?
  totalPausedDays Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student  Student          @relation(fields: [studentId], references: [id])
  package  LearningPackage  @relation(fields: [packageId], references: [id])
  invoices TuitionInvoice[]

  @@index([studentId, status, endDate])
  @@index([packageId, status])
}

model BankTransferEvent {
  id            String                  @id @default(cuid())
  provider      String
  transactionId String
  amount        Decimal                 @db.Decimal(12, 2)
  description   String
  accountNo     String?
  transferredAt DateTime
  status        BankTransferEventStatus @default(RECEIVED)

  invoiceId  String?
  paymentId  String?
  note       String?
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, transactionId])
  @@index([status, transferredAt])
  @@index([invoiceId])
}

model IntegrationSecret {
  id        String   @id @default(cuid())
  provider  String
  key       String
  valueEnc  String
  iv        String
  authTag   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, key])
  @@index([provider])
}
